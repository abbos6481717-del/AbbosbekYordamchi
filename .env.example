# Local development and testing only.
#   macOS / Linux:       cp .env.example .env && chmod 600 .env
#   Windows PowerShell:  Copy-Item .env.example .env
# Railway does not use this file: set Variables with the same names there.
# Comments must stay on their own lines (python-dotenv misreads "KEY=  # comment").

# Bot token from @BotFather (format <number>:<text>).
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID (ask @userinfobot).
OWNER_ID=

# false = PREVIEW mode: replies are only shown in the logs, nothing is sent.
# true  = replies are sent from your account. Accepted: true/false/1/0/yes/no/on/off.
AUTO_SEND=false

# Output of `claude setup-token` (starts with sk-ant-oat...). This is your
# Claude subscription token, NOT an Anthropic API key (sk-ant-api... is rejected).
# Create it once on a computer with a browser; it is valid for 1 year.
# Keep it like a password. Paste it with a text editor, on ONE line
# (terminals wrap long lines, copying can break it). Do not use `echo ... >> .env`:
# the token would stay in your shell history.
# Leave empty to use this machine's own `claude` login (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = found on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Claude model. Empty = the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh or max.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# Minutes to wait after a subscription usage limit when the CLI gives no reset time (minimum 1).
LIMIT_COOLDOWN_MINUTES=30

# After you write in a chat yourself, the bot stays quiet there for this many minutes (0 = off).
OWNER_TAKEOVER_MINUTES=15

# Messages kept per chat as context (minimum 1).
HISTORY_LIMIT=30

# ---- Userbot mode (python bot.py --userbot): your own account, no Premium needed ----
# From https://my.telegram.org -> API development tools. Keep api_hash like a password.
# TELEGRAM_BOT_TOKEN and OWNER_ID are not needed in this mode.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# true = reply only to people saved in your contacts; false = everyone in private chats.
USERBOT_CONTACTS_ONLY=true

# Most replies sent per hour (minimum 1). Keep it low: Telegram may restrict accounts
# that send many automatic messages.
USERBOT_MAX_REPLIES_PER_HOUR=20

# Seconds to wait before replying (0 = right away). If you answer yourself during this
# time the bot stays quiet; several messages in a row get one reply. 120 = 2 minutes.
USERBOT_REPLY_DELAY_SECONDS=0

# Fixed reply to a greeting ("Salom", "Assalomu alaykum, yaxshimisiz?", "Xayrli kun",
# "Привет", "Hello", Cyrillic too), sent at once (no reply delay), without Claude, at most
# once per 12 hours per chat. Empty = off (Claude answers greetings too).
USERBOT_GREETING_TEXT=

# Text sent with the greeting, e.g. the menu link (empty = none). With mode=text it is
# added to the same message.
USERBOT_GREETING_FOLLOWUP=

# true = send the greeting even while AUTO_SEND=false (Claude replies stay previews).
USERBOT_GREETING_SEND=false

# How the greeting is sent: voice (voice message), text, or both.
USERBOT_GREETING_MODE=voice

# Put before the bot's first message in each chat (again after 12 hours), e.g.
# "Assalomu alaykum! Men <Ism>ning online yordamchisiman". When set, Claude speaks as your
# assistant (about you in the third person) instead of pretending to be you.
USERBOT_INTRO_TEXT=

# Comma-separated contact names (as saved in Telegram), @usernames or numeric ids that are
# answered at once, without USERBOT_REPLY_DELAY_SECONDS. The startup log shows which matched.
USERBOT_FAST_CONTACTS=

# Contacts (names, @usernames or ids) the bot never answers.
USERBOT_IGNORE_CONTACTS=

# One recurring message: send USERBOT_SCHEDULE_TEXT to USERBOT_SCHEDULE_TO (name, @username
# or id; an id is safest) every USERBOT_SCHEDULE_EVERY_MINUTES minutes (0 = off).
USERBOT_SCHEDULE_TO=
USERBOT_SCHEDULE_TEXT=
USERBOT_SCHEDULE_EVERY_MINUTES=0

# Morning voice report (userbot mode), sent to your Saved Messages as a reminder (with a notification):
# today's hall bookings from the CRM + yesterday's sales read from the newest report photo in
# DAILY_REPORT_GROUP (title or numeric id). Empty DAILY_REPORT_TIME = off. From that time on the
# report goes out as soon as everything is complete (yesterday's table in the group + the CRM
# bookings), however late. DAILY_REPORT_WAIT_UNTIL (optional): from then on send with what it has.
# /hisobot in Saved Messages = now.
DAILY_REPORT_TIME=
DAILY_REPORT_WAIT_UNTIL=
DAILY_REPORT_GROUP=
DAILY_REPORT_VOICE=uz-UZ-MadinaNeural
DAILY_REPORT_PLACE=Olimp Garden
DAILY_REPORT_OWNER=
# CRM with the hall bookings (only read: /login, then /zbron). The password is yours to type in.
CRM_URL=
CRM_LOGIN=
CRM_PASSWORD=

# Voice for voice messages: uz-UZ-SardorNeural (male) or uz-UZ-MadinaNeural (female).
# The text is spoken by Microsoft's online voice service (only that text is sent there).
USERBOT_VOICE=uz-UZ-SardorNeural
